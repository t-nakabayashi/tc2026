<?xml version="1.0"?>
<package format="3">
  <name>icp_localization</name><version>0.1.0</version>
  <description>Fixed-map ICP with the common ENU pose interface</description>
  <maintainer email="kaz.ogata1988@gmail.com">Kazuki Ogata</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend><exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>sensor_msgs</exec_depend><exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend><exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend><exec_depend>tc_geo_msgs</exec_depend>
  <exec_depend>tc_diagnostics</exec_depend>
  <exec_depend>rtk_gps_um982_msgs</exec_depend><exec_depend>geo_pose_converter</exec_depend>
  <exec_depend>python3-numpy</exec_depend><exec_depend>python3-scipy</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
