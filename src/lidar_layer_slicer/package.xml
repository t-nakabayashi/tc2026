<?xml version="1.0"?>
<package format="3">
  <name>lidar_layer_slicer</name>
  <version>0.1.0</version>
  <description>MID-360の点群とtopURGのscanから水平スライス層の観測値と可視化画像を作るパッケージ</description>
  <maintainer email="kaz.ogata1988@gmail.com">Kazuki Ogata</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>sensor_msgs_py</depend>
  <depend>cv_bridge</depend>
  <depend>tf2_ros</depend>
  <depend>tc_perception_msgs</depend>
  <depend>tc_diagnostics</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
