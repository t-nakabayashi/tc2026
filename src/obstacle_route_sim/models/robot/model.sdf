<?xml version="1.0"?>
<sdf version="1.9">
  <model name="robot">
    <static>false</static>
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>50.0</mass>
        <pose>-0.1 0 0 0 0 0</pose>
        <inertia>
          <ixx>5.0</ixx>
          <iyy>5.0</iyy>
          <izz>5.0</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>-0.25 0 0.15 0 0 0</pose>
        <geometry><box><size>0.6 0.4 0.3</size></box></geometry>
      </collision>
      <visual name="visual">
        <pose>-0.25 0 0.15 0 0 0</pose>
        <geometry><box><size>0.6 0.4 0.3</size></box></geometry>
        <material>
          <ambient>0.1 0.25 0.8 1</ambient>
          <diffuse>0.1 0.25 0.8 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="left_wheel_link">
      <pose>0 0.25 0.15 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.05</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <link name="right_wheel_link">
      <pose>0 -0.25 0.15 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.05</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.15</radius><length>0.05</length></cylinder></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
      </visual>
    </link>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit><lower>-1e16</lower><upper>1e16</upper></limit>
      </axis>
    </joint>

    <link name="rear_caster_link">
      <pose>-0.55 0 0.07 0 0 0</pose>
      <inertial>
        <mass>5.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision"><geometry><sphere><radius>0.07</radius></sphere></geometry></collision>
      <visual name="visual">
        <geometry><sphere><radius>0.07</radius></sphere></geometry>
        <material><ambient>0 0 0 1</ambient><diffuse>0 0 0 1</diffuse></material>
      </visual>
    </link>

    <joint name="rear_caster_joint" type="ball">
      <parent>base_link</parent>
      <child>rear_caster_link</child>
    </joint>

    <link name="laser">
      <pose>0.075 0 0.25 0 0 0</pose>
      <inertial>
        <mass>0.5</mass>
        <inertia><ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.1 0.1 0.1</size></box></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
      <sensor name="utm30" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>40</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>1080</samples>
              <resolution>1</resolution>
              <min_angle>-2.35619</min_angle>
              <max_angle>2.35619</max_angle>
            </horizontal>
          </scan>
          <range><min>0.2</min><max>30.0</max><resolution>0.01</resolution></range>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent>base_link</parent>
      <child>laser</child>
    </joint>

    <!-- MID-360 支持台。実機は横梁上の前下がりマウントで、センサ光学原点は床上 0.562 m、
         車軸中心の真上にある。車体上面から同じ高さまでの短い支持台とする。 -->
    <link name="sensor_post">
      <pose>0 0 0.506 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.005</ixx><iyy>0.005</iyy><izz>0.005</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.08 0.08 0.112</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.08 0.08 0.112</size></box></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
      </visual>
    </link>

    <joint name="sensor_post_joint" type="fixed">
      <parent>base_link</parent>
      <child>sensor_post</child>
    </joint>

    <link name="mid360_frame">
      <pose>0 0 0.562 -0.010472 0.469494 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.1</length></cylinder></geometry>
        <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
      </visual>
      <sensor name="mid360" type="gpu_lidar">
        <topic>/mid360/livox/lidar</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>900</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>24</samples>
              <resolution>1</resolution>
              <min_angle>-0.122</min_angle>
              <max_angle>0.907</max_angle>
            </vertical>
          </scan>
          <range><min>0.2</min><max>40.0</max><resolution>0.02</resolution></range>
        </lidar>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <!-- フロントカメラ。実機は C920 を 640x480 / 5 fps で使う。取付位置は実機で未計測の
         ため、支持台前面の床上 0.50 m、前方 0.115 m に置いた仮の値である。 -->
    <link name="camera_link">
      <pose>0.115 0 0.50 0 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="visual">
        <geometry><box><size>0.03 0.08 0.03</size></box></geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <sensor name="front_camera" type="camera">
        <topic>/usb_cam/image_raw</topic>
        <update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.2217</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>50.0</far></clip>
        </camera>
        <always_on>true</always_on>
        <visualize>false</visualize>
      </sensor>
    </link>

    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent>
      <child>camera_link</child>
    </joint>

    <joint name="mid360_joint" type="fixed">
      <parent>base_link</parent>
      <child>mid360_frame</child>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.5</wheel_separation>
      <wheel_radius>0.15</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/ypspur_ros/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>40</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
