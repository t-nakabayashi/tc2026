<?xml version="1.0"?>
<package format="3">
  <name>gnss_lio_fusion</name>
  <version>0.1.0</version>
  <description>適応baseline品質判定とGNSS/LIO平面融合</description>
  <maintainer email="kaz.ogata1988@gmail.com">Kazuki Ogata</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>tc_diagnostics</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>rtk_gps_um982_msgs</depend>
  <depend>tc_geo_msgs</depend>
  <depend>geo_pose_converter</depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
