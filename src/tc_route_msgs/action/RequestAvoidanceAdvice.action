# tc_route_msgs/action/RequestAvoidanceAdvice.action
# route_follower が avoidance_advisor へ回避の助言を要求する。
#
# 配信元: avoidance_advisor (action server) / route_follower (action client)
# 備考: 助言の入力となる点群画像・カメラ画像は server 側が購読済みの最新値から作る。
#       goal にはクランプ条件と観測ヒントのみを渡す。client は待機上限で goal を
#       cancel し、server は起動中の CLI プロセスを終了する。

string waypoint_label            # 要求時に追従していた waypoint のラベル
float32 waypoint_left_open_m     # waypoint が許す左の開放幅 [m]。0 以下は不可
float32 waypoint_right_open_m    # waypoint が許す右の開放幅 [m]。0 以下は不可
float32 front_clearance_m        # 観測した前方余裕距離 [m]
float32 hint_left_offset_m       # obstacle_monitor の左オフセット中央値 [m]
float32 hint_right_offset_m      # obstacle_monitor の右オフセット中央値 [m]
float32 min_offset_m             # 採用可能な最小オフセット [m]
float32 max_offset_m             # 採用可能な最大オフセット [m]
---
tc_route_msgs/AvoidanceAdvice advice
bool advice_valid                # false なら従来回避へ退避する
string failure_reason            # timeout / parse_error / schema_error / budget / disabled など
---
string phase                     # rendering / invoking / parsing
float32 elapsed_s
